# syntax=docker/dockerfile:1
# Build context is the backend/ folder:  docker build -f Qms.Api/Dockerfile backend
# Multi-arch (linux/amd64, linux/arm64): the build stage runs natively and publishes for the target architecture.

FROM --platform=$BUILDPLATFORM mcr.microsoft.com/dotnet/sdk:10.0 AS build
ARG TARGETARCH
# The "${TARGETARCH/amd64/x64}" substitution below needs bash (maps Docker arch names to .NET RIDs).
SHELL ["/bin/bash", "-c"]
COPY --from=ca ca-bundle.crt /usr/local/share/ca-certificates/ca-bundle.crt
RUN update-ca-certificates
WORKDIR /src

# Restore first, so the layer is cached until a project file or package version changes.
COPY global.json Directory.Build.props Directory.Packages.props ./
COPY Qms.Domain/Qms.Domain.csproj Qms.Domain/
COPY Qms.Application/Qms.Application.csproj Qms.Application/
COPY Qms.Infrastructure/Qms.Infrastructure.csproj Qms.Infrastructure/
COPY Qms.Api/Qms.Api.csproj Qms.Api/
RUN dotnet restore Qms.Api/Qms.Api.csproj -a ${TARGETARCH/amd64/x64}

COPY Qms.Domain/ Qms.Domain/
COPY Qms.Application/ Qms.Application/
COPY Qms.Infrastructure/ Qms.Infrastructure/
COPY Qms.Api/ Qms.Api/
RUN dotnet publish Qms.Api/Qms.Api.csproj -c Release -a ${TARGETARCH/amd64/x64} --no-restore -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
ENV ASPNETCORE_HTTP_PORTS=8080
# Log files are written here; the non-root user must own the folder.
RUN mkdir -p /app/logs && chown $APP_UID:$APP_UID /app/logs
COPY --from=build /app/publish .
# Non-root: $APP_UID is the built-in "app" user of the .NET images.
USER $APP_UID
EXPOSE 8080
ENTRYPOINT ["dotnet", "Qms.Api.dll"]
