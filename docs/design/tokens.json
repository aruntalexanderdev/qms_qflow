{
  "$description": "QMS design tokens: the single source of truth for colour, type, spacing, radius and elevation. Web (frontend/src/styles/_tokens.scss) and Android (android/.../ui/theme/) must mirror these values. Change this file first, then the theme files. See docs/design/DESIGN_SYSTEM.md.",
  "$version": "1.0.0",

  "color": {
    "brand": {
      "primary":          "#0D7E8F",
      "primary-hover":    "#0A6878",
      "primary-pressed":  "#085663",
      "primary-subtle":   "#E8F1F3",
      "on-primary":       "#FFFFFF",
      "on-primary-subtle":"#11676E",
      "focus-ring":       "rgba(13, 126, 143, 0.35)"
    },

    "nav": {
      "bg":           "#0F262A",
      "bg-hover":     "#163339",
      "border":       "#20363A",
      "text":         "#B8CFD0",
      "text-section": "#8AA3A7",
      "bullet":       "#3D5A5C",
      "active-bg":    "#0D7E8F",
      "active-text":  "#FFFFFF",
      "brand-title":  "#FFFFFF",
      "brand-sub":    "#8AA3A7"
    },

    "neutral": {
      "bg":            "#F4F6F6",
      "surface":       "#FFFFFF",
      "surface-muted": "#F9FAFA",
      "border":        "#E3E5E4",
      "border-input":  "#8A9094",
      "text":          "#111315",
      "text-label":    "#393F46",
      "text-muted":    "#6B7174",
      "text-placeholder": "#828689",
      "text-disabled": "#9AA0A4",
      "overlay":       "rgba(15, 38, 42, 0.48)"
    },

    "status": {
      "success":      { "fg": "#15803D", "bg": "#DCFCE7", "on-bg": "#166534" },
      "warning":      { "fg": "#B45309", "bg": "#FEF3C7", "on-bg": "#92400E" },
      "error":        { "fg": "#B42318", "bg": "#FEE4E2", "on-bg": "#B42318" },
      "info":         { "fg": "#1D4ED8", "bg": "#DBEAFE", "on-bg": "#1E40AF" }
    },

    "token-state": {
      "waiting":   { "bg": "#F2F4F7", "fg": "#475467" },
      "called":    { "bg": "#DBEAFE", "fg": "#1E40AF" },
      "serving":   { "bg": "#DCFCE7", "fg": "#166534" },
      "held":      { "bg": "#EDE9FE", "fg": "#5B21B6" },
      "no-show":   { "bg": "#FEE4E2", "fg": "#B42318" },
      "completed": { "bg": "#E8F1F3", "fg": "#11676E" },
      "cancelled": { "bg": "#F2F4F7", "fg": "#475467" }
    },

    "priority": {
      "normal": { "bg": "#F2F4F7", "fg": "#475467" },
      "vip":    { "bg": "#FEF9C3", "fg": "#854D0E" }
    },

    "counter-status": {
      "open":   { "bg": "#DCFCE7", "fg": "#166534" },
      "paused": { "bg": "#FEF3C7", "fg": "#92400E" },
      "closed": { "bg": "#F2F4F7", "fg": "#475467" }
    },

    "display": {
      "bg":            "#0F262A",
      "panel":         "#163339",
      "border":        "#20363A",
      "text":          "#FFFFFF",
      "text-muted":    "#B8CFD0",
      "accent":        "#5FC9D6",
      "latest-call-bg":"#0D7E8F",
      "latest-call-fg":"#FFFFFF",
      "calling":       "#FBBF24"
    }
  },

  "font": {
    "family": {
      "latin":  "'Instrument Sans', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
      "arabic": "'IBM Plex Sans Arabic', 'Instrument Sans', system-ui, sans-serif",
      "mono":   "ui-monospace, 'SF Mono', Menlo, Consolas, monospace"
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "size": {
      "xs": "12px", "sm": "14px", "md": "15px", "lg": "16px",
      "xl": "20px", "2xl": "24px", "3xl": "28px", "4xl": "36px"
    },
    "line-height": { "tight": 1.2, "normal": 1.5 },
    "letter-spacing": { "section-label": "0.08em", "heading": "-0.01em" },
    "display": {
      "token-latest":  "clamp(96px, 14vw, 200px)",
      "token-list":    "clamp(40px, 5vw, 72px)",
      "counter-label": "clamp(28px, 3vw, 48px)"
    }
  },

  "space": {
    "0": "0", "1": "4px", "2": "8px", "3": "12px", "4": "16px",
    "5": "20px", "6": "24px", "8": "32px", "10": "40px", "12": "48px", "16": "64px"
  },

  "radius": { "sm": "6px", "md": "8px", "lg": "12px", "xl": "16px", "full": "9999px" },

  "shadow": {
    "none": "none",
    "sm":   "0 1px 2px rgba(16, 18, 17, 0.05)",
    "md":   "0 4px 12px rgba(16, 18, 17, 0.08)",
    "lg":   "0 12px 32px rgba(16, 18, 17, 0.12)"
  },

  "size": {
    "sidebar-width": "280px",
    "sidebar-width-collapsed": "72px",
    "topbar-height": "64px",
    "control-height": "44px",
    "control-height-sm": "36px",
    "content-max-width": "1200px",
    "form-max-width": "848px",
    "kiosk-touch-target": "72px"
  },

  "motion": {
    "fast": "120ms", "normal": "200ms", "slow": "320ms",
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  },

  "breakpoint": { "sm": "640px", "md": "768px", "lg": "1024px", "xl": "1280px" }
}
