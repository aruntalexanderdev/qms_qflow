# Copy to .env (git-ignored) and adjust. Placeholders only - never commit real values.

# PostgreSQL (container "postgres")
POSTGRES_DB=qms
POSTGRES_USER=qms
POSTGRES_PASSWORD=change-me-local-only

# API (container "api")
# Development enables Swagger UI at http://localhost:8080/swagger; use Production to match deployments.
ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080
POSTGRES_PORT=5432
