# Copy to .env (git-ignored) and adjust. Placeholders only - never commit real values.

# PostgreSQL (container "postgres")
POSTGRES_DB=qms
POSTGRES_USER=qms
POSTGRES_PASSWORD=change-me-local-only

# API (container "api")
# Development enables Swagger UI at http://localhost:8080/swagger and is for the local stack only (the API port
# is bound to 127.0.0.1). Any deployed environment must use Production.
ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080

# Web app (container "web", STORY-004): open http://localhost:4200 in Chrome, Edge or Firefox.
WEB_PORT=4200
POSTGRES_PORT=5432

# Authentication (STORY-003, ADR-004). Required: the API refuses to start without a signing key.
# JWT_SIGNING_KEY signs the 15-minute access tokens: at least 32 characters, random, never reused between environments.
# Generate one:  openssl rand -base64 48
JWT_SIGNING_KEY=

# Development / test seed only (ignored in Production). Leave a pair empty to skip that user. Passwords must satisfy the
# Identity policy (6+ characters, upper, lower, digit, symbol). The Company Admin belongs to Company 1.
SEED_SUPERADMIN_USERNAME=
SEED_SUPERADMIN_PASSWORD=
SEED_COMPANYADMIN_USERNAME=
SEED_COMPANYADMIN_PASSWORD=
